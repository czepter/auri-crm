{
    "openapi": "3.1.0",
    "info": {
        "title": "Laravel",
        "version": "0.0.1"
    },
    "servers": [
        {
            "url": "http://localhost/api"
        }
    ],
    "paths": {
        "/whoami": {
            "get": {
                "operationId": "whoami",
                "tags": [
                    "GuestIdentity"
                ],
                "responses": {
                    "200": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "contact": {
                                            "type": "object",
                                            "properties": {
                                                "public_id": {
                                                    "type": "string"
                                                },
                                                "name": {
                                                    "type": "string"
                                                }
                                            },
                                            "required": [
                                                "public_id",
                                                "name"
                                            ]
                                        }
                                    },
                                    "required": [
                                        "contact"
                                    ]
                                }
                            }
                        }
                    }
                }
            }
        },
        "/health": {
            "get": {
                "operationId": "health",
                "tags": [
                    "Health"
                ],
                "responses": {
                    "200": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "status": {
                                            "type": "string",
                                            "const": "ok"
                                        },
                                        "database": {
                                            "type": "string",
                                            "const": "ok"
                                        }
                                    },
                                    "required": [
                                        "status",
                                        "database"
                                    ]
                                }
                            }
                        }
                    }
                }
            }
        },
        "/stripe/webhook": {
            "post": {
                "operationId": "stripe.webhook",
                "tags": [
                    "StripeWebhook"
                ],
                "responses": {
                    "204": {
                        "description": "No content"
                    },
                    "400": {
                        "description": ""
                    }
                }
            }
        }
    }
}