{
    "openapi": "3.1.0",
    "info": {
        "title": "Laravel",
        "version": "0.0.1"
    },
    "servers": [
        {
            "url": "http://localhost:8000/api"
        }
    ],
    "paths": {
        "/gallery-versions/{galleryVersion}/images/{key}": {
            "get": {
                "operationId": "gallery-versions.images.show",
                "tags": [
                    "GalleryImage"
                ],
                "parameters": [
                    {
                        "name": "galleryVersion",
                        "in": "path",
                        "required": true,
                        "description": "The gallery version public id",
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "key",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "string"
                                }
                            }
                        },
                        "headers": {
                            "Cache-Control": {
                                "schema": {
                                    "type": "string",
                                    "const": "public, max-age=31536000, immutable"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "An error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "description": "Error overview.",
                                            "examples": [
                                                ""
                                            ]
                                        }
                                    },
                                    "required": [
                                        "message"
                                    ]
                                }
                            }
                        }
                    },
                    "404": {
                        "$ref": "#/components/responses/ModelNotFoundException"
                    }
                }
            }
        },
        "/galleries/{gallery}": {
            "get": {
                "operationId": "galleries.show",
                "tags": [
                    "GalleryRead"
                ],
                "parameters": [
                    {
                        "name": "gallery",
                        "in": "path",
                        "required": true,
                        "description": "The gallery public id",
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "gallery": {
                                            "type": "object",
                                            "properties": {
                                                "public_id": {
                                                    "type": "string"
                                                },
                                                "title": {
                                                    "type": [
                                                        "string",
                                                        "null"
                                                    ]
                                                },
                                                "version": {
                                                    "type": "object",
                                                    "properties": {
                                                        "public_id": {
                                                            "type": "string"
                                                        },
                                                        "version": {
                                                            "type": "integer"
                                                        },
                                                        "published_at": {
                                                            "type": "string",
                                                            "format": "date-time"
                                                        },
                                                        "assets": {
                                                            "type": "array",
                                                            "items": {
                                                                "type": "object",
                                                                "properties": {
                                                                    "key": {
                                                                        "type": "string"
                                                                    },
                                                                    "width": {
                                                                        "type": [
                                                                            "string",
                                                                            "null"
                                                                        ]
                                                                    },
                                                                    "height": {
                                                                        "type": [
                                                                            "string",
                                                                            "null"
                                                                        ]
                                                                    }
                                                                },
                                                                "required": [
                                                                    "key",
                                                                    "width",
                                                                    "height"
                                                                ]
                                                            }
                                                        }
                                                    },
                                                    "required": [
                                                        "public_id",
                                                        "version",
                                                        "published_at",
                                                        "assets"
                                                    ]
                                                }
                                            },
                                            "required": [
                                                "public_id",
                                                "title",
                                                "version"
                                            ]
                                        }
                                    },
                                    "required": [
                                        "gallery"
                                    ]
                                }
                            }
                        }
                    },
                    "404": {
                        "$ref": "#/components/responses/ModelNotFoundException"
                    }
                }
            }
        },
        "/whoami": {
            "get": {
                "operationId": "whoami",
                "tags": [
                    "GuestIdentity"
                ],
                "responses": {
                    "200": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "contact": {
                                            "type": "object",
                                            "properties": {
                                                "public_id": {
                                                    "type": "string"
                                                },
                                                "name": {
                                                    "type": "string"
                                                }
                                            },
                                            "required": [
                                                "public_id",
                                                "name"
                                            ]
                                        }
                                    },
                                    "required": [
                                        "contact"
                                    ]
                                }
                            }
                        }
                    }
                }
            }
        },
        "/health": {
            "get": {
                "operationId": "health",
                "tags": [
                    "Health"
                ],
                "responses": {
                    "200": {
                        "description": "",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "status": {
                                            "type": "string",
                                            "const": "ok"
                                        },
                                        "database": {
                                            "type": "string",
                                            "const": "ok"
                                        }
                                    },
                                    "required": [
                                        "status",
                                        "database"
                                    ]
                                }
                            }
                        }
                    }
                }
            }
        },
        "/stripe/webhook": {
            "post": {
                "operationId": "stripe.webhook",
                "tags": [
                    "StripeWebhook"
                ],
                "responses": {
                    "204": {
                        "description": "No content"
                    },
                    "400": {
                        "description": ""
                    }
                }
            }
        }
    },
    "components": {
        "responses": {
            "ModelNotFoundException": {
                "description": "Not found",
                "content": {
                    "application/json": {
                        "schema": {
                            "type": "object",
                            "properties": {
                                "message": {
                                    "type": "string",
                                    "description": "Error overview."
                                }
                            },
                            "required": [
                                "message"
                            ]
                        }
                    }
                }
            }
        }
    }
}