{
  "name": "@studio/mcp",
  "private": true,
  "type": "module",
  "bin": {
    "studio-mcp": "./dist/index.js"
  },
  "scripts": {
    "generate": "openapi-typescript ../contracts/openapi.json -o src/generated/openapi.d.ts",
    "prebuild": "pnpm generate",
    "build": "tsc -p tsconfig.json",
    "pretest": "pnpm build",
    "test": "vitest run --passWithNoTests",
    "prelint": "pnpm generate",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "openapi-fetch": "^0.17.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
