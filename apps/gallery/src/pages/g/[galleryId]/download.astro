---
import { buyPass, passCookieName } from '../../../lib/viewPass'
import { confirm as confirmGuest, guestCookieName, GUEST_MAX_AGE_SECONDS, nameFromEmail, requestCode } from '../../../lib/guest'
import {
  buyDownloadPass,
  DOWNLOAD_MAX_AGE_SECONDS,
  downloadCookieName,
  formatBytes,
  prepareDownload,
  readOffer,
} from '../../../lib/download'
import '../../../styles/app.css'

Astro.response.headers.set('Cache-Control', 'no-store')

const apiBase = process.env.API_URL ?? 'http://localhost:8000'
const publicApi = process.env.PUBLIC_API_URL ?? apiBase
const { galleryId } = Astro.params
const requestId = Astro.locals.requestId
const cookieOptions = (maxAge: number) => ({
  path: `/g/${galleryId}`,
  httpOnly: true,
  sameSite: 'lax' as const,
  secure: import.meta.env.PROD,
  maxAge,
})

let view = Astro.cookies.get(passCookieName(galleryId!))?.value ?? null
let guest = Astro.cookies.get(guestCookieName(galleryId!))?.value ?? null
let download = Astro.cookies.get(downloadCookieName(galleryId!))?.value ?? null

let pinWrong = false
let pendingEmail: string | null = null
let codeSent = false
let codeWrong = false
let tooManyCodes = false

if (view === null) {
  view = await buyPass(apiBase, galleryId!, requestId)
}

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData()
  const intent = String(form.get('absicht') ?? '')

  if (intent === 'pin') {
    const bought = await buyDownloadPass(apiBase, galleryId!, requestId, String(form.get('pin') ?? ''), view)

    if (bought === null) {
      pinWrong = true
    } else {
      download = bought
      Astro.cookies.set(downloadCookieName(galleryId!), bought, cookieOptions(DOWNLOAD_MAX_AGE_SECONDS))
    }
  } else if (intent === 'anmelden') {
    pendingEmail = String(form.get('gast_email') ?? '')
    const name = String(form.get('gast_name') ?? '') || nameFromEmail(pendingEmail)

    codeSent = await requestCode(apiBase, galleryId!, requestId, pendingEmail, name, view)
    tooManyCodes = !codeSent
  } else if (intent === 'bestaetigen') {
    pendingEmail = String(form.get('gast_email') ?? '')

    const identity = await confirmGuest(
      apiBase,
      galleryId!,
      requestId,
      { email: pendingEmail, code: String(form.get('code') ?? '') },
      view,
    )

    if (identity === null) {
      codeSent = true
      codeWrong = true
    } else {
      guest = identity.pass
      Astro.cookies.set(guestCookieName(galleryId!), identity.pass, cookieOptions(GUEST_MAX_AGE_SECONDS))
      Astro.cookies.set(`${guestCookieName(galleryId!)}_wer`, identity.name, cookieOptions(GUEST_MAX_AGE_SECONDS))
    }
  } else if (intent === 'vorbereiten') {
    await prepareDownload(apiBase, galleryId!, requestId, String(form.get('size') ?? ''), { view, guest, download })
  }
}

const { offer } = await readOffer(apiBase, galleryId!, requestId, { view, guest, download })

if (offer === null) {
  return Astro.redirect(`/g/${galleryId}`, 303)
}

const SIZE_LABEL = { original: 'Original', web: 'Web' } as const
const building = offer.builds.some((build) => build.status === 'building')
---

<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    {building && <meta http-equiv="refresh" content="10" />}
    <title>{offer.gallery.title}</title>
  </head>
  <body>
    <section class="gate">
      <div class="lock">
        <h1 class="display">{offer.gallery.title}</h1>
        <p class="meta">{offer.gallery.count} Bilder</p>

        <div>
          <div class="hair" />

          {
            offer.step === 'pin' && (
              <form method="POST">
                <input type="hidden" name="absicht" value="pin" />
                <div class="field">
                  <label for="pin">Download-Code</label>
                  <input id="pin" name="pin" type="text" inputmode="numeric" autocomplete="off" required />
                </div>
                {pinWrong && <p class="err">Dieser Code stimmt nicht.</p>}
                <button class="btn" type="submit">Weiter</button>
              </form>
            )
          }

          {
            offer.step === 'email' && codeSent && (
              <form method="POST">
                <input type="hidden" name="absicht" value="bestaetigen" />
                <input type="hidden" name="gast_email" value={pendingEmail ?? ''} />
                <p class="hint">Wir haben dir sechs Ziffern an {pendingEmail} geschickt.</p>
                <div class="field">
                  <label for="code">Code</label>
                  <input id="code" name="code" type="text" inputmode="numeric" autocomplete="one-time-code" maxlength="6" required />
                </div>
                {codeWrong && <p class="err">Der Code stimmt nicht oder ist abgelaufen.</p>}
                <button class="btn" type="submit">Bestätigen</button>
              </form>
            )
          }

          {
            offer.step === 'email' && !codeSent && (
              <form method="POST">
                <input type="hidden" name="absicht" value="anmelden" />
                <div class="field">
                  <label for="email">E-Mail</label>
                  <input id="email" name="gast_email" type="email" autocomplete="email" required />
                </div>
                <div class="field">
                  <label for="name">Name</label>
                  <input id="name" name="gast_name" type="text" autocomplete="name" required />
                </div>
                {tooManyCodes && <p class="err">Zu viele Anfragen. Versuch es später noch einmal.</p>}
                <button class="btn" type="submit">Weiter</button>
              </form>
            )
          }

          {
            offer.step === 'ready' && (
              <ul class="dl">
                {(['original', 'web'] as const).map((size) => {
                  const build = offer.builds.find((b) => b.size === size)

                  return (
                    <li>
                      <span class="dl-name">{SIZE_LABEL[size]}</span>
                      <span class="dl-size">{formatBytes(offer.sizes[size] ?? 0)}</span>
                      {build?.status === 'ready' ? (
                        <span class="dl-parts">
                          {build.parts.map((part) => (
                            <a class="barbtn solid" href={`${publicApi}${part.path}`}>
                              {build.parts.length > 1 ? `Teil ${part.number}` : 'Herunterladen'}
                            </a>
                          ))}
                        </span>
                      ) : build?.status === 'building' ? (
                        <span class="dl-state">Wird vorbereitet</span>
                      ) : (
                        <form method="POST">
                          <input type="hidden" name="absicht" value="vorbereiten" />
                          <input type="hidden" name="size" value={size} />
                          <button class="barbtn" type="submit">{build?.status === 'failed' ? 'Erneut' : 'Vorbereiten'}</button>
                        </form>
                      )}
                    </li>
                  )
                })}
              </ul>
            )
          }

          <p class="hint"><a href={`/g/${galleryId}`}>Zurück zur Galerie</a></p>
        </div>
      </div>
    </section>
  </body>
</html>
