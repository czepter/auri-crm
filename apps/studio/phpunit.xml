<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
        <testsuite name="Arch">
            <directory>tests/Arch</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
        <!--
            StudioSettings::current() reads the `redis` cache store by name, and
            bootstrap/app.php asks it for the schedule's timezone before any test
            has swapped that store for an array. With the dev app running on the
            same Redis, the suite read its cached settings (a studio set to
            Europe/Berlin) instead of the test database's. Own prefix, own keys.
        -->
        <env name="CACHE_PREFIX" value="phpunit_" force="true"/>
        <server name="CACHE_PREFIX" value="phpunit_" force="true"/>
        <!--
            Same reason as DB_DATABASE below: docker-compose.yml sets
            MAIL_MAILER=smtp on the php service, and a real environment
            variable is in $_SERVER, which Laravel's env repository reads
            before $_ENV. An <env> line loses there even with force — only
            the <server> twin reaches the adapter that answers first.
        -->
        <env name="MAIL_MAILER" value="array" force="true"/>
        <server name="MAIL_MAILER" value="array" force="true"/>
        <env name="PULSE_ENABLED" value="false"/>
        <!-- Sonst ruft jede gerenderte Inertia-Seite die SSR-Hot-URL des
             laufenden Vite-Servers an, und die Suite faellt genau dann, wenn
             jemand nebenher entwickelt. -->
        <env name="INERTIA_SSR_ENABLED" value="false"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="DB_CONNECTION" value="pgsql"/>
        <!--
            force, or this line does nothing where it matters most.

            docker-compose.yml sets DB_DATABASE=studio on the php service as a
            real environment variable, and PHPUnit leaves an already-set
            variable alone unless told otherwise. Without force the suite ran
            RefreshDatabase against the development database and dropped it on
            every run, while studio_test was never so much as migrated.
        -->
        <env name="DB_DATABASE" value="studio_test" force="true"/>
        <server name="DB_DATABASE" value="studio_test" force="true"/>
        <!-- #357: forced for the same reason as DB_DATABASE — the php service
             sets it, and a suite that publishes to the dev hub counts one
             request too many wherever it fakes Http. -->
        <env name="MERCURE_URL" value="" force="true"/>
        <server name="MERCURE_URL" value="" force="true"/>
        <env name="APP_SURFACE" value="admin"/>
    </php>
</phpunit>
