APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000
APP_SURFACE=admin
TENANT_ID=00000000-0000-4000-8000-000000000001

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=studio
DB_USERNAME=studio
DB_PASSWORD=studio

SESSION_DRIVER=database
SESSION_LIFETIME=720
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=studio
AWS_SECRET_ACCESS_KEY=studio-media-secret
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=media
# Left unset by default (real AWS S3, no override needed) — the local Compose
# stack sets this to the `minio` service for its php/worker containers itself
# (docker-compose.yml), the same way it overrides DB_HOST rather than relying
# on this file. See config/filesystems.php's `s3` disk (G-01a) and
# docs/media.md: the disk is written to run unmodified against any
# S3-compatible endpoint, chosen at deploy time.
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# apps/gallery, the guest viewer Gallery::publicUrl() points at — never a
# guest's own studio-host link. Left at its dev default here; the local
# Compose stack overrides it to match GALLERY_PORT (docker-compose.yml),
# the same way it overrides AWS_ENDPOINT above rather than relying on this
# file. docker-compose.coolify.yml sets the deployed equivalent from
# ${SERVICE_FQDN_GALLERY_4321}.
GALLERY_URL=http://localhost:4321

# Die Versionsliste hinter /neuigkeiten. Ohne sie bleibt der Screen leer.
RELEASE_LOG_URL=https://uew53y9iuh4kievlxtcshuyc.coolify3.czpt.de

VITE_APP_NAME="${APP_NAME}"
API_URL=
# Der OAuth-Aussteller für die MCP-Verbindung, gelesen vom api-Surface
# (OAuthProtectedResourceController). Leer heisst APP_URL.
ADMIN_URL=
# Nur setzen, wenn ein Proxy die MCP-Route anders veröffentlicht als
# API_URL/mcp.
MCP_URL=
